# Meson build folders (build/, and any other build*/ such as build-release/)
/build*/
# Downloaded subprojects (wrap files and packagefiles stay tracked)
/subprojects/*
!/subprojects/*.wrap
!/subprojects/packagefiles/
# Local subprojects: raylib's build files and the vendored Box2D
!/subprojects/raylib/
!/subprojects/box2d/

# Sources downloaded at configure time (raylib, when -Draylib:raylib_dir isn't given)
/subprojects/raylib/downloads/

# Exports of the test projects: generated by the editor (Export / Play), so not tracked
/tests/*/export/

# Per-user editor state in projects (open tabs)
.sceneeditor/

# Leftovers of interrupted saves (scenes, projects and the editor config are written via .tmp)
*.tmp

# OS files
.DS_Store
Thumbs.db
desktop.ini
